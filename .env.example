# SQLite database file path (relative to project root).
# Used by lib/db.ts, drizzle.config.ts, and npm run db:* scripts.
#
# Copy to .env.local for local overrides:
#   cp .env.example .env.local
#
# Default if unset: ./data/prediction-tracker.sqlite
DATABASE_URL=./data/prediction-tracker.sqlite

# Staff gate for write APIs (create prediction, set outcome).
# Paste the same value into the password field on /staff/add.
# Do not commit a real value; set it in .env.local (and your host’s env UI).
#
# Unset in production means all writes 401 until you set it.
STAFF_SECRET=